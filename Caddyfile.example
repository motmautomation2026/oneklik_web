# Add this block to your existing Caddyfile on the VPS — not a standalone
# file, just the snippet this app needs. Replace the domain with the real
# one you're pointing at this app.
#
# Nginx inside the frontend container handles the /api split internally
# (proxying to the backend over the Docker network), so Caddy only needs
# to know about one upstream: the frontend's published port.

oneklik.example.com {
    reverse_proxy localhost:4012
}
