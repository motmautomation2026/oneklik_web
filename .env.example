# Root .env — read by docker-compose for the frontend's build args only.
# The backend still gets its own full config from backend/.env directly
# (see backend/.env.example). Copy this to .env on the VPS and fill in
# real values; .env itself is gitignored.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — shown as a mailto link on the account-suspended/banned screen.
# Leave blank to omit the address (the screen still tells users to contact support).
VITE_SUPPORT_EMAIL=
